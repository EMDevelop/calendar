{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "lib": ["ES2024"],
    "types": ["node", "electron-vite/node"],
    "allowImportingTsExtensions": true
  },
  "include": [
    "electron.vite.config.ts",
    "vitest.config.ts",
    "src/main/**/*",
    "src/shared/**/*",
    "scripts/**/*",
    "tests/**/*"
  ]
}
