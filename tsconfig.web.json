{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "allowImportingTsExtensions": true
  },
  // The preload runs in the renderer process, so it needs DOM types as well as
  // Electron's.
  "include": ["src/renderer/**/*", "src/preload/**/*", "src/shared/**/*"]
}
